{
  "name": "social-media-content-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/dev.ts\"",
    "dev:local": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx server/devLocal.ts\"",
    "build": "vue-tsc --noEmit && vite build",
    "vercel-build": "drizzle-kit migrate && npm run build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "admin:create": "tsx scripts/create-admin.ts",
    "keys:generate": "tsx scripts/generate-key.ts",
    "secrets:reencrypt": "tsx scripts/reencrypt.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@primeuix/themes": "^2.0.3",
    "@tanstack/vue-query": "^5.107.1",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pinia": "^4.1.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "sharp": "^0.35.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
