# Copy to .env.local (or .env) for local development; .env.local takes precedence. Never commit real values.

# Neon Postgres connection string. Use a separate Neon branch for local dev, never production.
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# AES-256-GCM key ring for tokens and secrets (ADR-0008). Newest key first; generate one with `npm run keys:generate`.
# Rotation: put the new key first, run `npm run secrets:reencrypt`, then remove the old key.
ENCRYPTION_KEYS=v1:REPLACE_WITH_32_BYTE_BASE64_KEY

# Scheduled jobs (vercel.json "crons") are refused unless this is set; any long random string.
CRON_SECRET=

# Optional: the browser origin allowed by CORS. Defaults to the API's own origin.
APP_ORIGIN=

# Local API port for `npm run dev` (Vite proxies /api to it).
API_PORT=3001

# Meta app (Phase 2). The App Secret goes only in Vercel's environment variables, never in the repo.
META_APP_ID=1805184584083738
META_APP_SECRET=
